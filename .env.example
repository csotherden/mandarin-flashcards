# Native `go run ./cmd/api-server` settings.
# Docker Compose generates JWT_SECRET and JWT_REFRESH_SECRET on first boot
# when these are left unset. For a native server, set both to 32+ characters.

ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
DB_HOST=localhost
DB_PORT=5433
DB_USER=mandarin
DB_PASSWORD=mandarin
DB_NAME=mandarin
DB_SSL_MODE=disable
AUTO_MIGRATE=true
LOG_LEVEL=debug
FILE_STORE_DIR=./data/files
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8091

# Paid upstream keys. Leave blank until you have them; the API returns a clear
# "not configured" error instead of calling the provider.
TONEPERFECT_API_KEY=
UNSPLASH_ACCESS_KEY=
# UNSPLASH_API_URL and TONEPERFECT_API_URL point at a stand-in (a local mock); empty is the real API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# JWT_SECRET=
# JWT_REFRESH_SECRET=
